# Virtual environment
venv/
.venv/
env/

# Python cache
__pycache__/
*.py[cod]
*$py.class
*.pyo

# Flask / SQLite instance folder and databases
instance/
*.db
*.sqlite
*.sqlite3

# Uploaded (encrypted) files — never commit user data
uploads/

# Environment variables — never commit secrets
.env

# Byte-compiled / distribution
*.egg-info/
dist/
build/
.eggs/

# IDE / OS files
.vscode/
.idea/
*.DS_Store
Thumbs.db
